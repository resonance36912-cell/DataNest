#!/bin/sh
set -eu

blocked=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    if [ "${RONSAS_ALLOW_MAIN_PUSH:-}" = "1" ]; then
      echo "RONSAS governance override: direct main push explicitly allowed." >&2
    else
      echo "RONSAS governance: direct pushes to main are blocked. Push a review branch and merge via PR." >&2
      blocked=1
    fi
  fi
done

exit "$blocked"
