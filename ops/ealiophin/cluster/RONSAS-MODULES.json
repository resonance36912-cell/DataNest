    {
      "id": "ollama",
      "kind": "local-model-runtime",
      "displayName": "RONSAS Ollama Runtime",
      "port": 11434,
      "listenPort": 11434,
      "health": "http://127.0.0.1:11434/",
      "required": true
    }
  ],
  "externalIngress": {
    "kind": "optional-public-transport",
    "provider": "Cloudflare named tunnel",
    "requiredForLocalGovernance": false,
    "canonicalPublicOrigin": "https://reson8.life"
  }
}
