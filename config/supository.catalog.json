  "rdMirror": {
    "repository": "DataNest-Supository/Mirror-DataNest",
    "mode": "peer-production-rd",
    "sourceOfTruth": false,
    "productionAuthority": true,
    "mirrorProductionDeploymentAuthority": true,
    "mirrorProductionBackendAuthority": true,
    "canonicalProductionAuthority": false,
    "mirrorCandidateDeploymentAuthority": true,
    "canonicalLiveDeploymentAuthority": false,
    "previewUrl": "https://datanest-supository.github.io/Mirror-DataNest/",
    "backend": {
      "project": "Supabase:qchttpcyqlqnhvahprhz",
      "name": "Mirror DataNest isolated production",
      "mode": "isolated-production"
    },
    "adminAccess": {
      "canonicalUiToggle": true,
      "allowedRoles": [
        "owner",
        "admin"
      ],
      "opensLiveMirrorUi": true,
      "synchronizesExactBuildEvidence": true,
      "changesCanonicalProductionAuthority": false,
      "networkAccessControl": false
    },
    "updateManagement": {
      "reuseExistingDatabaseModels": true,
      "models": [
        "product_surfaces",
        "product_test_cases",
        "product_test_runs",
        "governance_observations",
        "optimizer_runs",
        "optimizer_suggestions",
        "governance_improvement_candidates",
        "security_acceptance_runs",
        "portfolio_lifecycle_events",
        "ai_development_updates",
        "artifacts",
        "events"
      ],
      "surfaceName": "Mirror-DataNest Production Surface",
      "releaseManifest": "/Mirror-DataNest/mirror-release.json",
      "liveVerificationArtifact": "mirror-live-evidence-<run>-<sha>",
      "certificationWorkflow": ".github/workflows/datanest-ai-certification.yml",
      "stagingSchemaPolicy": "Certification workflow validates governed staging schema and backend acceptance before canonical release."
    },
    "productionPromotion": {
      "allProductionCandidatesMustReturnToCanonical": false,
      "canonicalHandoffRequiredOnlyFor": "/DataNest/",
      "mirrorLiveWorkflow": "Mirror-DataNest/.github/workflows/pages.yml",
      "candidateWorkflow": "Mirror-DataNest/.github/workflows/production-candidate.yml",
      "canonicalImportWorkflow": ".github/workflows/mirror-production-import.yml",
      "canonicalBranchPrefix": "mirror-promotion/",
      "requiredBeforeLive": [
        "mirror promotion reference",
        "live Mirror visual/functional evidence reference",
        "DataNest AI Certification reference",
        "Audit Optimizer reference",
        "canonical PR verification",
        "security scan",
        "RONSAS validation where applicable",
        "governance review",
        "human reviewer approval",
        "production authorization"
      ],
      "liveDeploymentAuthority": {
        "mirrorSurface": "DataNest-Supository/Mirror-DataNest",
        "canonicalSurface": "DataNest-Supository/DataNest"
      }
    }
  },
  "specializedTrees": {
    "knowledge": {
      "path": "knowledge/",
      "mode": "repository-learning",
      "productionAuthority": false,
      "feedBranch": "automation/knowledge-feed"
    },
    "boundaries": {
      "path": "boundaries/",
      "mode": "acceptance-and-tolerance",
      "productionAuthority": false,
      "assessmentWorkflow": ".github/workflows/boundaries-assessment.yml"
    },
    "botsquad": {
      "path": "botsquad/",
      "mode": "ai-only-advisory",
      "productionAuthority": false,
      "branchPrefix": "automation/botsquad/",
