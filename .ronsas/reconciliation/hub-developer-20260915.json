      ],
      "decision": "defer-import-pending-protocol-hardening",
      "rationale": "The runtime ROP helper and Hub outbound push scheme omit the nonce required by the portable ROP contract, leaving replay protection inconsistent.",
      "requirements": [
        "Unify runtime and portable signatures on timestamp + nonce + body with replay rejection.",
        "Validate outbound control origins against an explicit allowlist before fetch.",
        "Redact or constrain delivery request/response logging before persistence.",
        "Review pull-config schema compatibility independently from outbound push support."
      ]
    }
