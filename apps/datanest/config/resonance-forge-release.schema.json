{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resonance Forge Release Manifest",
  "type": "object",
  "required": [
    "schemaVersion", "candidateId", "repository", "commitSha",
    "canonicalBaseSha", "environment", "evidenceRefs", "authorizationState"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "candidateId": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "commitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "canonicalBaseSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "buildId": {"type": ["string", "null"]},
    "workflowRef": {"type": ["string", "null"]},
    "artifactDigests": {"type": "array", "items": {"type": "string"}},
    "backend": {
      "type": "object",
      "required": ["mode", "projectRef"],
      "properties": {
        "mode": {"type": "string"},
        "projectRef": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "environment": {"type": "string", "enum": ["rd", "staging", "candidate", "production"]},
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "policyVersion": {"type": ["string", "null"]},
    "authorizationState": {
      "type": "string",
      "enum": ["unauthorized", "candidate", "human-authorized", "production", "blocked"]
    },
    "rollbackTarget": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
  },
  "additionalProperties": false
}