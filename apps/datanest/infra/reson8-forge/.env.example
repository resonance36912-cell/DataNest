FORGE_APP_NAME=Reson8 Forge
FORGE_DOMAIN=git.reson8.life

POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=replace-with-a-long-random-secret

FORGE_DISABLE_SSH=true
FORGE_DISABLE_REGISTRATION=true
FORGE_REQUIRE_SIGNIN_VIEW=false

# Optional off-site backup destination for scripts/backup.sh.
# Configure rclone separately, then set for example:
# DROPBOX_REMOTE=dropbox:Reson8/ForgeBackups
DROPBOX_REMOTE=
