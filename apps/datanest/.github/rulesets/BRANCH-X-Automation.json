{
  "name": "BRANCH-X Automation",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/automation/**",
        "refs/heads/audit/**",
        "refs/heads/ci/**"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "CI"
          },
          {
            "context": "BRANCH-X Protection Tree"
          }
        ],
        "strict_required_status_checks_policy": true
      }
    }
  ]
}
