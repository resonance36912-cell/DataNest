# Preferred runtime configuration (provider-agnostic)
SUPABASE_URL=https://sgqdmfgjbprsoqsmgigi.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility aliases for platforms that inject NEXT_PUBLIC_* at build time
# NEXT_PUBLIC_SUPABASE_URL=https://sgqdmfgjbprsoqsmgigi.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# Optional project-shared open-source/open-weight DataNest AI endpoint.
# Keep these server-side. The endpoint must be HTTPS on 443 and its hostname
# must already be present in the DataNest AI provider domain allowlist.
# These values are used only when an authenticated user has no personal provider.
# Generic provider example:
# DATANEST_SHARED_AI_BASE_URL=https://ai.example.com/v1/chat/completions
# DATANEST_SHARED_AI_HOST=ai.example.com
# DATANEST_SHARED_AI_MODEL=<open-source-model-id>
# DATANEST_SHARED_AI_SECRET=<server-side-bearer-secret>
# DATANEST_SHARED_AI_LABEL=DataNest Sovereign AI
#
# 2026-09-28 bootstrap profile: Cloudflare Workers AI (replace <ACCOUNT_ID>).
# The API token must remain server-side and have only the minimum Workers AI permission needed.
# DATANEST_SHARED_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
# DATANEST_SHARED_AI_HOST=api.cloudflare.com
# DATANEST_SHARED_AI_MODEL=@cf/nvidia/nemotron-3-120b-a12b
# DATANEST_SHARED_AI_SECRET=<cloudflare-workers-ai-api-token>
# DATANEST_SHARED_AI_LABEL=DataNest Open AI · Nemotron 3 Super

# Resonance AiPI Core v0.1.
# Bind each server-side gateway key to an explicit Resonance project. Repeat a
# project to support controlled key rotation. Never expose these as NEXT_PUBLIC_*.
# AIPI_PROJECT_KEYS=resonance-demo=<gateway-key-current>,resonance-demo=<gateway-key-next>
# AIPI_ALLOWED_MODELS=<model-a>,<model-b>
# AIPI_UPSTREAM_URL=https://ai.example.com/v1/chat/completions
# AIPI_UPSTREAM_HOST=ai.example.com
# AIPI_UPSTREAM_API_KEY=<server-side-provider-key>
#
# When AIPI_ALLOWED_MODELS / AIPI_UPSTREAM_* are omitted, AiPI can fall back to
# DATANEST_SHARED_AI_MODEL / DATANEST_SHARED_AI_BASE_URL / DATANEST_SHARED_AI_HOST /
# DATANEST_SHARED_AI_SECRET to reuse the existing DataNest shared provider path.
