{
  "schema": "datanest.ronsas.module-registry.v2",
  "suite": "RONSAS",
  "fullName": "Resonance Open Nova Sovereign Application Suite",
  "repository": "DataNest-Supository/DataNest",
  "authority": {
    "sourceRoot": ".",
    "controlRoot": "ops/ronsas/ealiophin",
    "runtimeRoot": "%LOCALAPPDATA%\\Resonance\\DataNest-RONSAS",
    "backupHost": {
      "provider": "Dropbox",
      "path": "/DataNest-AI-Backups",
      "role": "artifact-recovery",
      "servesApplication": false
    }
