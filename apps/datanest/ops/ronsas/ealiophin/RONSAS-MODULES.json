  "policy": {
    "singleRepositoryAuthority": true,
    "localFirst": true,
    "standaloneRepositories": "evidence-only",
    "billingState": "free-promotion",
    "paidCheckoutActive": false,
    "localPcBackupHosting": false,
    "backupProvider": "dropbox",
    "backupPath": "/DataNest-AI-Backups"
  },
  "modules": [
